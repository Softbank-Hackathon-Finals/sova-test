        <mxCell id="n20" value="전환 후: 신규 쓰기·첨부까지 역방향 복구 대상" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#64748b;fontStyle=0;" vertex="1" parent="1">
