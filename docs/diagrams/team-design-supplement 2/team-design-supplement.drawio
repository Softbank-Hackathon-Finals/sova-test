        <mxCell id="box0" value="&lt;b style=&quot;font-size:22px&quot;&gt;불변 계획 · 입력 결합&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;소스 · patch · 테스트 · 이미지&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;환경 · 정책 revision · 기한&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd0dc;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="76" y="290" width="364" height="110" />
        </mxCell>
        <mxCell id="box1" value="&lt;b style=&quot;font-size:22px&quot;&gt;리허설 · 독립 검증&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;제한된 작업 환경에서 수정&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;별도 검증기와 근거 결합&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#a435ff;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="76" y="480" width="364" height="110" />
        </mxCell>
        <mxCell id="box2" value="&lt;b style=&quot;font-size:22px&quot;&gt;사람 승인&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;정확한 계획 · 범위 · 한도&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;새 승인이 보안 보류를 지우지 않음&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd0dc;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="76" y="670" width="364" height="110" />
        </mxCell>
        <mxCell id="box3" value="&lt;b style=&quot;font-size:22px&quot;&gt;실행 직전 검증&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;현재 승인 · 근거 · 정책 · 보류&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;앱 실행권 · epoch · 만료&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#f97316;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="568" y="290" width="424" height="110" />
        </mxCell>
        <mxCell id="box4" value="&lt;b style=&quot;font-size:22px&quot;&gt;외부 효과 의도 선기록&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;PREPARED → IN_FLIGHT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;외부 호출 전에 DB에 확정&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#f97316;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="568" y="480" width="424" height="110" />
        </mxCell>
        <mxCell id="box5" value="&lt;b style=&quot;font-size:22px&quot;&gt;범위 제한 Executor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;등록 자원 · 허용 동작만 실행&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;호출 중 DB 행 잠금 해제&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#f97316;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="568" y="670" width="424" height="110" />
        </mxCell>
        <mxCell id="box6" value="&lt;b style=&quot;font-size:22px&quot;&gt;실제 상태 readback&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;응답 문자열만으로 성공 처리 금지&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#f97316;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="568" y="820" width="424" height="85" />
        </mxCell>
        <mxCell id="box7" value="&lt;b style=&quot;font-size:22px&quot;&gt;현재 정책 · 독립 보안 보류&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;승인 취소 · 권한 회수도 반영&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;미확인된 필수 조건은 차단&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#ef2929;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1120" y="290" width="404" height="110" />
        </mxCell>
        <mxCell id="box8" value="&lt;b style=&quot;font-size:22px&quot;&gt;실제 변경 대상&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;DB · PgBouncer · Edge&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;객체 저장소 · 서비스 신원&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;일반 writer와 실제 자원 검증&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd0dc;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1120" y="480" width="404" height="155" />
        </mxCell>
        <mxCell id="box9" value="&lt;b style=&quot;font-size:22px&quot;&gt;제어 DB · 감사 기록&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;의도 · 관측 · 완료 · 복구 이력&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;미해결 효과는 일반 재실행 차단&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd0dc;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1120" y="710" width="404" height="110" />
        </mxCell>
        <mxCell id="n29" value="완료 주장은 검증한 범위로 제한" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#64748b;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="115.5" y="836" width="285" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="실행 안전성: 응답이 사라져도 중복 실행 방지" id="02-effect-journal">
