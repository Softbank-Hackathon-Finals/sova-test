        <mxCell id="box2" value="&lt;b style=&quot;font-size:22px&quot;&gt;패치 · 빌드 산출물&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;source / patch / image digest&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;검증 기준은 변경할 수 없음&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#a435ff;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="76" y="650" width="389" height="105" />
        </mxCell>
        <mxCell id="box3" value="&lt;b style=&quot;font-size:22px&quot;&gt;전달 전 검사&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;경로 · 크기 · 파일 유형&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;symlink · 특수 파일 차단&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;원래 요청과 산출물 결합&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#f97316;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="583" y="455" width="384" height="145" />
        </mxCell>
        <mxCell id="box4" value="&lt;b style=&quot;font-size:22px&quot;&gt;별도 verifier 실행&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;고정 테스트 · 검증기 버전&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;요청 · 테스트 · 산출물 일치&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;근거의 출처와 유효기간 확인&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2457ff;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1085" y="455" width="439" height="145" />
        </mxCell>
        <mxCell id="box5" value="&lt;b style=&quot;font-size:22px&quot;&gt;플랫폼 보관 테스트&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;검증 시점에 별도 주입&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;작업 Pod에서 읽기·수정 금지&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd0dc;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1085" y="650" width="439" height="105" />
        </mxCell>
        <mxCell id="box6" value="&lt;b style=&quot;font-size:22px&quot;&gt;요청 전체의 결합&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;scope · source · tests · image&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;정책 · 환경 · 만료 · 한도&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#f97316;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="583" y="650" width="384" height="105" />
        </mxCell>
        <mxCell id="box7" value="&lt;b style=&quot;font-size:22px&quot;&gt;도구 계층의 권한 제한&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;namespace + 작업 ID + Pod UID + action + deadline&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#ef2929;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="850" width="947" height="100" />
        </mxCell>
        <mxCell id="box8" value="&lt;b style=&quot;font-size:22px&quot;&gt;결과 수용 → 사람 승인&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;PASS는 운영 실행 권한과 별개&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#f97316;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1057" y="850" width="495" height="100" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
