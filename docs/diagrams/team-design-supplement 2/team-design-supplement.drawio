        <mxCell id="n2" value="정상 호출과 응답 유실을 구분한다. 불명확한 변경은 재호출보다 조회·조정을 우선한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#64748b;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="77" width="1180" height="42" />
