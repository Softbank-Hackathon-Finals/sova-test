        <mxCell id="box0" value="&lt;b style=&quot;font-size:22px&quot;&gt;신뢰된 입력 기준본&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;읽기 전용 소스 · 고정 테스트 · 정책 · 요청 digest · 환경 revision&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd0dc;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="175" width="1504" height="110" />
        </mxCell>
        <mxCell id="box1" value="&lt;b style=&quot;font-size:22px&quot;&gt;작업 복사본 수정&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;승인된 도구 · Pod UID만 실행&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;시간 · 자원 · 네트워크 한도&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#a435ff;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="76" y="455" width="389" height="110" />
