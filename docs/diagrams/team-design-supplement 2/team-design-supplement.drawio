        <mxCell id="n2" value="DB 행만 옮겨서는 완료되지 않는다. 객체 내용·참조·진행 중 쓰기와 복구 경로를 함께 확인한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#64748b;fontStyle=0;" vertex="1" parent="1">
