        <mxCell id="box5" value="&lt;b style=&quot;font-size:22px&quot;&gt;변경 허용&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;등록된 대상에&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;허용된 동작만&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#079447;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1308" y="300" width="226" height="145" />
        </mxCell>
        <mxCell id="box6" value="&lt;b style=&quot;font-size:22px&quot;&gt;차단 · 사유와 현재 조건 기록&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;거부 · revision 변경 · 만료 · 미확인 · 보류 충돌 · 실행권 상실&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;필수 조건 하나라도 충족하지 못하면 외부 변경을 시작하지 않는다.&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#ef2929;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="605" width="1234" height="120" />
        </mxCell>
        <mxCell id="box7" value="&lt;b style=&quot;font-size:21px&quot;&gt;실제 결과 확인&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;readback 후 판정&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;새 관측 근거 저장&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#079447;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1308" y="605" width="244" height="120" />
        </mxCell>
        <mxCell id="box8" value="&lt;b style=&quot;font-size:22px&quot;&gt;승인 이후 입력이 바뀌면&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;기존 계획을 덮어쓰지 않고 새 revision을 만든다.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;영향받는 근거와 승인을 다시 확인한다.&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd0dc;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="800" width="726" height="115" />
        </mxCell>
        <mxCell id="box9" value="&lt;b style=&quot;font-size:22px&quot;&gt;승인 취소와 결과 기록은 구분&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;새로운 변경은 막고, 이미 발행한 효과의 관측은 보존한다.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#64748b&quot;&gt;일반 승인으로 독립 보안 보류를 해제하지 않는다.&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd0dc;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;fontColor=#0f172a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="826" y="800" width="726" height="115" />
        </mxCell>
      </root>
    </mxGraphModel>
