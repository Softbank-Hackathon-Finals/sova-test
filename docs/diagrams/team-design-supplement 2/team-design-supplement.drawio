        <mxCell id="n7" value="━━  직접 구현 · 판단" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#f97316;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1290" y="97" width="280" height="28" />
