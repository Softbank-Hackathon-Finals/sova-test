        <mxCell id="n3" value="설계 보충안 · 목표 구조이며 구현 완료를 의미하지 않음" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#64748b;fontStyle=0;" vertex="1" parent="1">
