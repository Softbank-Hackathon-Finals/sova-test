{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "kind": "Service",
      "metadata": {
        "name": "entry",
        "namespace": "orders",
        "uid": "uid-entry",
        "resourceVersion": "7",
        "labels": {
          "app.kubernetes.io/part-of": "orders"
        }
      },
      "spec": {
        "selector": {
          "app": "api"
        }
      }
    },
    {
      "kind": "Deployment",
      "metadata": {
        "name": "api",
        "namespace": "orders",
        "uid": "uid-api",
        "resourceVersion": "7",
        "labels": {
          "app.kubernetes.io/part-of": "orders"
        }
      },
      "spec": {
        "template": {
          "metadata": {
            "labels": {
              "app": "api"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "app",
                "env": [
                  {
                    "name": "TOKEN",
                    "value": "example-not-a-secret"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "data"
                }
              }
            ]
          }
        }
      }
    },
    {
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "data",
        "namespace": "orders",
        "uid": "uid-data",
        "resourceVersion": "7",
        "labels": {
          "app.kubernetes.io/part-of": "orders"
        }
      },
      "spec": {}
    }
  ]
}
